APP_URL="http://localhost:3000"
JWT_SECRECT_KEY=""
STYLESHEET_URL="./path/to/css"
JAVASCRIPT_URL="./path/to/js"

# Local Postgres (see compose.yaml). Defaults match the dev container, which
# binds host port 5433 to avoid colliding with any Postgres on 5432.
# These same values are read by both compose.yaml and config/database.yml.
DATABASE_HOST="localhost"
DATABASE_PORT="5433"
DATABASE_USER="postgres"
DATABASE_PASSWORD="postgres"
DATABASE_NAME="budget_app_inertia"
TEST_DATABASE_NAME="api_test"

# Optional: pin the Vite HMR websocket host (e.g. your LAN IP) when accessing
# the dev app from another device. Leave unset for normal local development.
VITE_HMR_HOST=""
