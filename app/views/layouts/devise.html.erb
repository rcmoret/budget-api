<!DOCTYPE html>
<html data-theme="merrimack-light">
  <head>
    <title>Budget App</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="shortcut icon" href="/favicon.png">

    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="https://kit.fontawesome.com/50bb231d0e.js" crossorigin="anonymous"></script>

    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
    <%= vite_javascript_tag "public.tsx" %>
  </head>

  <body>
    <div class="flex flex-row items-start">
      <nav class="lg:w-60 md:w-44 min-w-40 h-screen sticky top-0 grid grid-rows-[1fr_auto] pt-4 text-base-content">
        <div aria-label="Budget" class="flex flex-col gap-2 py-3">
          <div class="top-level-link" aria-current="page">
            <span>
              Sign In
            </span>
          </div>
        </div>
      </nav>
      <div class="flex-1 flex flex-col min-h-screen">
        <div class="grid-page-split">
          <header class="grid-page-header grid sticky top-0 z-10 bg-base-100 grid-cols-subgrid shadow-lg col-span-full items-center min-h-20 border-b-2 border-secondary">
            <h1 class="text-2xl text-content font-medium tracking-wide">
              Budget Tracker
            </h1>
            <div></div>
          </header>
          <main id="sign-in" class="grid gap-2 pt-4 overflow-y-scroll scrollbar-gutter-stable with-scroll-fixes w-full">
            <%= yield %>
          </main>
          <%# Right-column grid cell; public.tsx renders notifications here. %>
          <aside id="public-shell" class="flex flex-col gap-2 py-4 overflow-y-scroll"></aside>
        </div>
      </div>
    </div>

    <%# Data bridge for the public.tsx entry point. %>
    <script type="application/json" id="public-page-data">
      <%= raw(public_page_data_json) %>
    </script>
  </body>
</html>
